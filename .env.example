# Postgres connection string. On Vercel this is injected automatically once a Neon
# database is connected to the project (Storage tab), so you normally set nothing.
DATABASE_URL=

# The one password that opens the app. Set it yourself in Vercel > Settings > Environment Variables.
# Use a long random value. Without it the app stays locked.
APP_PASSWORD=

# Any long random string. Vercel Cron sends it when it calls /api/cron/prices once a day.
# Without it the daily reference-price update stays off (the manual button still works).
CRON_SECRET=
